<idea-plugin>
    <!--
        Loaded only when the GitHub Copilot plugin (com.github.copilot) is installed, see the optional
        <depends> entry in plugin.xml. Adds our Export/Import actions to the popup menu that opens when
        the user clicks the GitHub Copilot icon in the IDE status bar (bottom-right of the main IDE
        window, NOT the Chat tool window toolbar).

        copilot.statusBarPopup / copilot.statusBarRestartPopup / copilot.statusBarErrorPopup are the
        internal group ids the GitHub Copilot plugin renders for that status bar icon depending on its
        current state (ready / restart required / error or logged out). They are not a published
        extension point, so this is a best-effort integration: if a future Copilot release renames or
        removes them, our contribution simply stops appearing without breaking this plugin.
    -->
    <actions>
        <group id="CopilotSessionsImportExport.CopilotStatusBarMenu"
               text="Github Copilot sessions"
               icon="/icons/copilotSessions.svg"
               popup="true">
            <reference ref="CopilotSessionsImportExport.Export"/>
            <reference ref="CopilotSessionsImportExport.Import"/>
            <add-to-group group-id="copilot.statusBarPopup" anchor="last"/>
            <add-to-group group-id="copilot.statusBarRestartPopup" anchor="last"/>
            <add-to-group group-id="copilot.statusBarErrorPopup" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
